# Application Settings
PROJECT_NAME="Multi-Agent Academic Research Assistant"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Neon PostgreSQL Database Connection URL
DATABASE_URL="postgresql://user:pass@ep-cool-db.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Redis Cache URL
REDIS_URL="redis://localhost:6379/0"

# LLM API Keys & Model Configuration (Gemini / OpenAI)
OPENAI_API_KEY="your-openai-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_FALLBACK_MODELS="gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash"

# Frontend Next.js Public API URL
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=multi-agent-literature-review
LANGCHAIN_API_KEY=lsv2_pt_your_actual_copied_key_here

# AWS S3 PDF Storage (Agent 05 Caching)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket-name-here

# Hugging Face Hub (Fast weights download & avoids unauthenticated rate limits)
# Get a free read token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Groq Cloud LLM Fallback (Provides ultra-fast fallback when Gemini quota limits are reached)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODELS="openai/gpt-oss-20b,llama-3.3-70b-versatile,llama-3.1-8b-instant"

# ----------------------------------------------------
# 1. JWT Authentication Settings
# ----------------------------------------------------
JWT_SECRET_KEY="<generated_secret_string>"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# ----------------------------------------------------
# 2. Google OAuth 2.0
# ----------------------------------------------------
GOOGLE_CLIENT_ID="<your_google_client_id>.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="<your_google_client_secret>"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback"

# ----------------------------------------------------
# 3. GitHub OAuth
# ----------------------------------------------------
GITHUB_CLIENT_ID="<your_github_client_id>"
GITHUB_CLIENT_SECRET="<your_github_client_secret>"
GITHUB_REDIRECT_URI="http://localhost:3000/auth/callback"

# ----------------------------------------------------
# 4. Frontend Client IDs (Vite)
# ----------------------------------------------------
VITE_GOOGLE_CLIENT_ID="<same_as_GOOGLE_CLIENT_ID>"
VITE_GITHUB_CLIENT_ID="<same_as_GITHUB_CLIENT_ID>"
